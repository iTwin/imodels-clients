{
  "$schema": "https://developer.microsoft.com/json-schemas/rush/v5/pnpm-config.schema.json",
  "useWorkspaces": true,
  "globalOverrides": {
    "serialize-javascript": "^7.0.3", // mocha > serialize-javascript@6.0.0 -> CVE: https://github.com/advisories/GHSA-5c6j-r48x-rmvq
    "uuid": "^11.1.1" // gaxios@6.x -> uuid@9.0.1 -> CVE: https://github.com/advisories/GHSA-w5hq-g745-h8pq
  },
  "globalOnlyBuiltDependencies": [
    "@bentley/imodeljs-native",
    "@playwright/browser-chromium",
    "cypress",
    "protobufjs"
  ],
  "unsupportedPackageJsonSettings": {
    "pnpm": {
      "auditConfig": {
        "ignoreGhsas": ["GHSA-vfj7-8cjw-p6xm"] // frivolous advisory, only affects a transitive dependency when used incorrectly
      }
    }
  }
}